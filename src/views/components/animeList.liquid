<h2 class="mx-2 p-2 text-white text-xl font-bold bg-gray-950">{{ head }}</h2>
<div id="{{ id }}" class="flex w-full flex-wrap px-2">
  {% if animeList.size == 0 %}
  <h2 class="text-white p-2 font-semibold">Nothing here 😢️</h2>
  {% endif %}
  {% for anime in animeList %}
  {% render "components/animeCard.liquid", thumb: anime.thumb, link: anime.link, title: anime.title %}
  {% endfor %}
  {% if more %}
  {% render "components/moreButton.liquid"
  , url: url %}
  {% endif %}
</div>