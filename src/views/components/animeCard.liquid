<div class="w-1/2 md:w-1/3 lg:w-1/6 h-52 p-2">
    <div class="w-full h-full relative">
        <div class="absolute -z-50 top-0 left-0 animate-pulse w-full h-full bg-gray-500"></div>
        <img class="w-full h-full object-cover z-50" src="{{ thumb }}" alt="">
        <a href="{{link}}"
            class="shade absolute top-0 left-0 w-full h-full bg-gray-600 bg-opacity-70 lg:bg-opacity-0 hover:bg-opacity-70 transition duration-200 ease-in-out group flex justify-center items-center">
            <h3
                class="text-center text-white font-medium absolute lg:opacity-0 group-hover:opacity-100 transition duration-200 ease-in-out">
                {{ title }}</h3>
        </a>
    </div>
</div>