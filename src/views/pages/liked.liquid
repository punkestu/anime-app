{% layout '../layout/main.liquid' %}
{% block page %}Recently Watch{% endblock %}
{% block body %}
<section id="liked" class="my-4">
    {% render "components/animeList.liquid", head: "Liked", animeList: [], id: "liked-anime" %}
</section>

<script src="/static/htmx.js"></script>
<script src="/public/localstorage.js"></script>
<script>
    const liked = getLiked();
    const likedContainer = document.getElementById("liked-anime");
    if (liked.length > 0) {
        likedContainer.innerHTML = liked.map(anime => {
            return `
      {% render "components/animeCard.liquid", thumb: "${anime.thumb}", link: "/detail/${anime.id}", title: "${anime.title}" %}
      `;
        }).join("");
    } else {
        likedContainer.innerHTML = `
    <h2 class="text-white p-2 font-semibold">Nothing here 😢️</h2>
    `;
    }
</script>
{% endblock %}