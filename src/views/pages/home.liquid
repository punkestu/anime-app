{% layout '../layout/main.liquid' %}
{% block page %}Home{% endblock %}
{% block body %}
<section id="liked" class="my-4">
  {% render "components/animeList.liquid", head: "Liked ❤️", animeList: [], id: "liked-anime" %}
</section>
<section id="recently" class="my-4">
  {% render "components/animeList.liquid", head: "Recently Watch", animeList: [], id: "recently-anime" %}
</section>
<section id="completed" class="my-4">
  {% render "components/animeList.liquid"
  , head: "Complete"
  , animeList: buffer.complete
  , more: true
  , url: "/complete" %}
</section>
<section id="ongoing" class="my-4">
  {% render "components/animeList.liquid"
  , head: "On Going"
  , animeList: buffer.on_going
  , more: true
  , url: "/ongoing" %}
</section>
<script src="/static/htmx.js"></script>
<script src="/public/localstorage.js"></script>
<script>
  const recently = getCurrentlyWatchs();
  const recentlyContainer = document.getElementById("recently-anime");
  if (recently.length > 0) {
    recentlyContainer.innerHTML = recently.slice(0, 5).map(anime => {
      return `
      {% render "components/animeCard.liquid", thumb: "${anime.thumb}", link: "/detail/${anime.id}", title: "${anime.title}" %}
      `;
    }).join("") + `
      {% render "components/moreButton.liquid", url: "/recently" %}
    `;
  } else {
    recentlyContainer.innerHTML = `
    <h2 class="text-white p-2 font-semibold">Nothing here 😢️</h2>
    `;
  }

  const liked = getLiked();
  const likedContainer = document.getElementById("liked-anime");
  if (liked.length > 0) {
    likedContainer.innerHTML = liked.slice(0, 5).map(anime => {
      return `
      {% render "components/animeCard.liquid", thumb: "${anime.thumb}", link: "/detail/${anime.id}", title: "${anime.title}" %}
      `;
    }).join("") + `
      {% render "components/moreButton.liquid", url: "/liked" %}
      `;
  } else {
    likedContainer.innerHTML = `
    <h2 class="text-white p-2 font-semibold">Nothing here 😢️</h2>
    `;
  }
</script>
{% endblock %}