{% layout '../layout/main.liquid' %}
{% block page %}Recently Watch{% endblock %}
{% block body %}
<section id="recently" class="my-4">
    {% render "components/animeList.liquid", head: "Recently Watch", animeList: [], id: "recently-anime" %}
</section>

<script src="/static/htmx.js"></script>
<script src="/public/localstorage.js"></script>
<script>
    const recently = getCurrentlyWatchs();
    const recentlyContainer = document.getElementById("recently-anime");
    if (recently.length > 0) {
        recentlyContainer.innerHTML = recently.map(anime => {
            return `
      {% render "components/animeCard.liquid", thumb: "${anime.thumb}", link: "/detail/${anime.id}", title: "${anime.title}" %}
      `;
        }).join("");
    } else {
        recentlyContainer.innerHTML = `
    <h2 class="text-white p-2 font-semibold">Nothing here 😢️</h2>
    `;
    }
</script>
{% endblock %}